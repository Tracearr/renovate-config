{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // House style for every Tracearr repo. Repos extend this and add only their own
  // package groups.
  //
  // Ordering contract: this preset's packageRules are evaluated before the extending
  // repo's, and for any field both set, the later rule wins. That is what lets a repo
  // pull a package back out of a broad group here — see the @types/* group below.

  // best-practices includes recommended, action SHA pinning, npm cooldown, abandonment
  // flags, docker digest pins, weekly lockfile maintenance, and dev-dep version pinning.
  "extends": ["config:best-practices", "security:openssf-scorecard"],

  // Lockfile already pins effective versions, so pinning in package.json is just noise.
  "ignorePresets": [":pinDevDependencies"],

  // Later syntax is deprecated upstream, cron only.
  "timezone": "UTC",
  "schedule": ["* 0-5 * * 1"],

  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,

  // behind-base-branch rebased every open PR on every push to main.
  "rebaseWhen": "conflicted",

  // Repos here have no required checks, so platform automerge would merge before CI.
  // Renovate-side merge waits for green.
  "platformAutomerge": false,

  // CLAUDE.md: no commit prefixes, no emojis, no attribution.
  "semanticCommits": "disabled",
  "commitMessagePrefix": "",
  "commitMessageAction": "Update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",

  // One PR per major instead of jumping to latest.
  "separateMultipleMajor": true,

  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "dependencyDashboardLabels": ["dependencies"],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "priority"]
  },
  "osvVulnerabilityAlerts": true,

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"],
    "commitMessageAction": "Refresh",
    "commitMessageTopic": "lockfile"
  },

  // No global minimumReleaseAge: best-practices gives npm 3d, and a floor on
  // Docker digests resets on every tag re-push so the group never clears.

  "packageRules": [
    // ----- supply-chain hardening -----

    // 7d cooldown for runtime deps. 3d for dev tooling is fine; prod gets longer
    // after the axios npm attack. Only runtime deps split minor/patch: patch
    // automerges, minor waits.
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "minimumReleaseAge": "7 days",
      "separateMinorPatch": true,
      "description": "Longer cooldown for runtime deps after axios March 2026"
    },

    // Actions automerge, so they keep the 3d cooldown.
    {
      "matchDatasources": ["github-tags"],
      "minimumReleaseAge": "3 days",
      "description": "3d cooldown for GitHub Actions"
    },

    // ----- shared groups -----

    // Broad catch-all. A repo that wants a specific @types package to ride with its
    // framework group declares that group locally; the later rule wins and pulls the
    // package back out. No exclusion lists to keep in sync.
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "type definitions"
    },

    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "eslint",
        "eslint-*",
        "@eslint/*",
        "typescript-eslint",
        "@typescript-eslint/*",
        "prettier",
        "prettier-*",
        "oxlint",
        "husky",
        "lint-staged"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Lint and format"
    },

    // ----- automerge -----

    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },

    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/*"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },

    // Runtime patches only. Minors still need review.
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },

    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },

    // ----- docker images -----

    // Every docker-datasource image across managers, so one image bump is one PR.
    // A repo that needs an image held back overrides it in a later local rule.
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Docker images",
      "labels": ["dep-docker"]
    },

    // Odd Node majors aren't LTS.
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^(20|22|24|26|28|30)\\./",
      "description": "Even-numbered Node majors only"
    },

    // ----- github actions -----
    // Excludes docker so CI service containers stay in the Docker images group above;
    // this rule runs later and would otherwise win. Action majors get reviewed by hand.
    {
      "matchManagers": ["github-actions"],
      "matchDatasources": ["!docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "labels": ["dep-ci"]
    },

    // Lock to currently-supported macOS runners.
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "matchPackageNames": ["macos"],
      "allowedVersions": "/^(14|15)$/"
    },

    // Assign and tag all majors.
    {
      "matchUpdateTypes": ["major"],
      "assignees": ["connorgallopo"],
      "labels": ["dep-major"]
    }
  ]
}
